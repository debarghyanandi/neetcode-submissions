# Normalise line endings at the repo boundary.
# Git stores LF; the working tree gets whatever each rule below says.
# This is why the Linux CI runner and your Windows clone can both write a file
# and produce identical bytes in the commit.

*               text=auto

# Content you read and edit on Windows -> CRLF on disk.
*.cs            text eol=crlf
*.html          text eol=crlf
*.md            text eol=crlf
*.csproj        text eol=crlf
*.sln           text eol=crlf

# Machinery that runs on the Linux CI runner -> LF on disk, always.
# A shebang followed by CR is a broken interpreter path.
*.mjs           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Never touch these.
*.png           binary
*.jpg           binary
*.gif           binary
*.pdf           binary
